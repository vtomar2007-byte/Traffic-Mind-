# Copy to .env and edit locally. The application also runs with safe defaults.
TRAFFICMIND_DATABASE_URL=sqlite:///./data/trafficmind.db
TRAFFICMIND_DATA_DIR=data
TRAFFICMIND_MODEL_PATH=
TRAFFICMIND_MAX_UPLOAD_MB=150
TRAFFICMIND_MAX_VIDEO_FRAMES=3000
TRAFFICMIND_PROCESS_EVERY_N_FRAMES=2
TRAFFICMIND_CONFIDENCE=0.35
TRAFFICMIND_COUNT_LINE_RATIO=0.5
TRAFFICMIND_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500
